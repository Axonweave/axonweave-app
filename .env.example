# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# All secrets must be generated securely (e.g. openssl rand -base64 32).

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Must be 32+ random characters in production
APP_SECRET_KEY=replace_with_secure_random_string_minimum_32_chars

# ── Database ─────────────────────────────────────────────────────────────────
# App role (DML only — used by the running backend)
DATABASE_URL=postgresql+psycopg://axonweave_app:replace_me@localhost:5432/axonweave
# Owner/migration role (DDL — used by Alembic only)
DATABASE_MIGRATION_URL=postgresql+psycopg://axonweave_owner:replace_me@localhost:5432/axonweave
# Owner password (used by docker-compose postgres service)
DB_OWNER_PASSWORD=replace_me

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Cookie settings ──────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Email ────────────────────────────────────────────────────────────────────
# Options: mailpit | console | sendgrid (future)
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# For production providers:
# EMAIL_API_KEY=replace_me
# EMAIL_FROM_ADDRESS=noreply@axonweave.app
# EMAIL_FROM_NAME=Axonweave

# ── Test database (for pytest, separate from dev DB) ─────────────────────────
DATABASE_TEST_URL=postgresql+psycopg://axonweave_owner:replace_me@localhost:5432/axonweave_test
